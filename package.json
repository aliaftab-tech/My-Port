{
  "name": "ali-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:ssr && node scripts/prerender.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr-build --logLevel warn",
    "lint": "oxlint",
    "preview": "node scripts/serve-dist.mjs",
    "shots": "node scripts/capture-screenshots.mjs && node scripts/optimise-shots.mjs && node scripts/image-sizes.mjs",
    "image-sizes": "node scripts/image-sizes.mjs",
    "serve:local": "node scripts/serve-local.mjs",
    "avatar": "node scripts/make-avatar.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
